{
  "schema_id": "harness-stats-native-corpus",
  "schema_version": "v1",
  "spec_anchor": "stats-3 票载裁决⑧（native-corpus-manifest 新 schema——独立于 pilot-bundle 四源语义；字段=corpus root/逐文件 path+hash+size+mtime/eligible 谓词（时间窗+workDir→project 归属）/观测时刻，沿 bundle 纪律）+ 22 §5.3（type allowlist/字段纪律）",
  "description": "Kimi/Codex 原生源冻结 corpus manifest（一次性冻结接触的产物）。pilot 语义：窗口=UTC 半开（缺省=九月窗 [2026-09-01T00:00Z, 2026-10-01T00:00Z)、与 pilot-bundle 同窗——§5.8）、project=AITrader2。窗口约束（pilot-window-parameterization 2026-10-13 r3 修订——协调方裁定：VR-S32 窗值 const 解钉为语义约束，窗口经 --from/--until 参数化、缺省=九月窗且生成串与原冻结原文逐字一致）：from/until=RFC3339 UTC 规范形（秒位必填 Z 后缀）+from<until（跨字段）；bounds=`半开 [from, until)` 照实派生（全秒形）；两源 time_interval=省秒形派生（双时格式保留——bounds 全秒形/interval 省秒形）；两源 eligible 谓词按窗生成照实记录（须含实际窗区间）。裁决⑤：原生面仅产 model-request（parent_entity_id=null），不产 dispatch；project 归因由 eligible 谓词在冻结时执行（workDir→注册表）。裁决⑦：游标 id=relpath#line、全序=文件相对路径字典序→行号。fixture 外形：{fixture_kind:'native-corpus', …字段}。",
  "fixture_envelope": {
    "rule": "VR-S28",
    "type": "object",
    "required": [
      "fixture_kind"
    ],
    "properties": {
      "fixture_kind": {
        "type": "string",
        "const": "native-corpus"
      },
      "description": {
        "type": "string"
      }
    }
  },
  "manifest": {
    "rule": "VR-S32",
    "type": "object",
    "required": [
      "manifest_kind",
      "corpus_id",
      "created_at",
      "observed_at",
      "project_id",
      "time_range",
      "kimi",
      "codex"
    ],
    "properties": {
      "manifest_kind": {
        "type": "string",
        "const": "native-corpus"
      },
      "corpus_id": {
        "type": "string",
        "pattern": "^native-[a-z0-9][a-z0-9-]*-\\d{6}-[0-9a-f]{8}$",
        "description": "内容寻址：native-<project>-<yyyymm>-<sha8>"
      },
      "created_at": {
        "type": "string",
        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$",
        "rule": "VR-S14"
      },
      "observed_at": {
        "type": "string",
        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$",
        "rule": "VR-S14",
        "description": "观测时刻（裁决⑧字段；活库数字必附 observed_at——22 §2.4 数字纪律）"
      },
      "project_id": {
        "type": "string",
        "minLength": 1
      },
      "time_range": {
        "type": "object",
        "description": "22 §5.8 同律：UTC 半开区间窗口（pilot-window-parameterization r3 解钉：窗值 const→语义约束——RFC3339 规范形+from<until+bounds 照实派生，缺省九月窗）",
        "required": [
          "from",
          "until",
          "bounds"
        ],
        "properties": {
          "from": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
            "rule": "VR-S32",
            "description": "窗下界（含）——RFC3339 UTC 规范形（秒位必填 Z 后缀）；跨字段：from < until"
          },
          "until": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
            "rule": "VR-S32",
            "description": "窗上界（不含）——同 from 规范形；制作时不得晚于判定时钟（--clock ?? 运行时刻——CLI 面 fail-loud）"
          },
          "bounds": {
            "type": "string",
            "minLength": 1,
            "rule": "VR-S32",
            "description": "半开区间文本=「半开 [from, until)」照实派生（全秒形——跨字段校验；双时格式：bounds 全秒形/time_interval 省秒形）"
          }
        },
        "additionalProperties": false
      },
      "kimi": {
        "type": "object",
        "rule": "VR-S32",
        "required": [
          "adapter_id",
          "adapter_type",
          "source_root",
          "total_scanned",
          "eligible_count",
          "excluded",
          "workdir_field",
          "time_field",
          "time_interval",
          "eligible_predicate",
          "eligible_files"
        ],
        "properties": {
          "adapter_id": {
            "type": "string",
            "const": "kimi-wire"
          },
          "adapter_type": {
            "type": "string",
            "const": "append-only",
            "description": "22 §5.3 两型；append-only 行不可变（§5.2 行 209）"
          },
          "source_root": {
            "type": "string",
            "minLength": 1,
            "description": "源根（冻结时观测；~/.kimi-code）"
          },
          "total_scanned": {
            "type": "integer",
            "minimum": 0
          },
          "eligible_count": {
            "type": "integer",
            "minimum": 0
          },
          "excluded": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "reason",
                "count"
              ],
              "properties": {
                "reason": {
                  "type": "string",
                  "minLength": 1
                },
                "count": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            }
          },
          "workdir_field": {
            "type": "string",
            "const": "session_index.jsonl workDir（会话目录级 join）"
          },
          "time_field": {
            "type": "string",
            "minLength": 1,
            "description": "实际执行的时间判定字段声明（首条 allowlist 行时戳；不可得时=mtime-approx 并注记）"
          },
          "time_interval": {
            "type": "string",
            "minLength": 1,
            "rule": "VR-S32",
            "description": "窗区间省秒形（「[from, until)」秒位 00 时省秒段；秒非 00 保全秒形——照实记录窗界）——跨字段照实派生校验（pilot-window-parameterization r3 解钉：原 const 九月字面）"
          },
          "eligible_predicate": {
            "type": "string",
            "minLength": 1,
            "rule": "VR-S32",
            "description": "kimi 侧 eligible 谓词——按窗生成照实记录（跨字段：须含实际窗区间；缺省九月窗生成串与原冻结原文逐字一致——pilot-window-parameterization r3 解钉：原 const 逐字冻结）"
          },
          "eligible_files": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "relative_path",
                "sha256",
                "size_bytes",
                "mtime_ms",
                "workdir",
                "session_first_at",
                "session_last_at"
              ],
              "properties": {
                "relative_path": {
                  "type": "string",
                  "minLength": 1,
                  "description": "源根内相对路径（wire.jsonl 所在会话目录相对位）"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$",
                  "rule": "VR-S27"
                },
                "size_bytes": {
                  "type": "integer",
                  "minimum": 0
                },
                "mtime_ms": {
                  "type": "integer",
                  "minimum": 0
                },
                "workdir": {
                  "type": "string",
                  "minLength": 1,
                  "description": "session_index workDir 原值（归因判定输入）"
                },
                "session_first_at": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$",
                  "rule": "VR-S14",
                  "description": "首条 allowlist 行时戳（mtime 近似时=time_field 注记 mtime-approx；不可得=null）"
                },
                "session_last_at": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$",
                  "rule": "VR-S14"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      },
      "codex": {
        "type": "object",
        "rule": "VR-S32",
        "required": [
          "adapter_id",
          "adapter_type",
          "source_root",
          "total_scanned",
          "eligible_count",
          "excluded",
          "workdir_field",
          "time_field",
          "time_interval",
          "eligible_predicate",
          "eligible_files"
        ],
        "properties": {
          "adapter_id": {
            "type": "string",
            "const": "codex-sessions"
          },
          "adapter_type": {
            "type": "string",
            "const": "append-only"
          },
          "source_root": {
            "type": "string",
            "minLength": 1,
            "description": "源根（冻结时观测；~/.codex/sessions）"
          },
          "total_scanned": {
            "type": "integer",
            "minimum": 0
          },
          "eligible_count": {
            "type": "integer",
            "minimum": 0
          },
          "excluded": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "reason",
                "count"
              ],
              "properties": {
                "reason": {
                  "type": "string",
                  "minLength": 1
                },
                "count": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            }
          },
          "workdir_field": {
            "type": "string",
            "const": "rollout session_meta.payload.cwd"
          },
          "time_field": {
            "type": "string",
            "minLength": 1,
            "description": "实际执行的时间判定字段声明（session_meta 时戳；不可得时=mtime-approx 并注记）"
          },
          "time_interval": {
            "type": "string",
            "minLength": 1,
            "rule": "VR-S32",
            "description": "窗区间省秒形（「[from, until)」秒位 00 时省秒段；秒非 00 保全秒形——照实记录窗界）——跨字段照实派生校验（pilot-window-parameterization r3 解钉：原 const 九月字面）"
          },
          "eligible_predicate": {
            "type": "string",
            "minLength": 1,
            "rule": "VR-S32",
            "description": "codex 侧 eligible 谓词——按窗生成照实记录（跨字段：须含实际窗区间；缺省九月窗生成串与原冻结原文逐字一致——pilot-window-parameterization r3 解钉：原 const 逐字冻结）"
          },
          "eligible_files": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "relative_path",
                "sha256",
                "size_bytes",
                "mtime_ms",
                "workdir",
                "session_first_at",
                "session_last_at"
              ],
              "properties": {
                "relative_path": {
                  "type": "string",
                  "minLength": 1,
                  "description": "sessions/ 内相对路径（YYYY/MM/DD/rollout-*.jsonl）"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$",
                  "rule": "VR-S27"
                },
                "size_bytes": {
                  "type": "integer",
                  "minimum": 0
                },
                "mtime_ms": {
                  "type": "integer",
                  "minimum": 0
                },
                "workdir": {
                  "type": "string",
                  "minLength": 1
                },
                "session_first_at": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$",
                  "rule": "VR-S14"
                },
                "session_last_at": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$",
                  "rule": "VR-S14"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      },
      "ticket_merges": {
        "type": "array",
        "description": "stats-5 M3 取数面（P1-1(a)）：票级 dogfood merge 观察——git log --grep ^merge: ticket <slug> 取 merge commit oid+committer 时戳；无匹配票不入清单（n/a 如实）。可选字段（additive——历史 corpus 无此字段兼容；report-manifest generation 同型先例）。",
        "items": {
          "type": "object",
          "required": ["slug", "merge_oid", "merge_ts"],
          "properties": {
            "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
            "merge_oid": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "merge_ts": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$", "rule": "VR-S14" }
          },
          "additionalProperties": false
        }
      }
    },
    "additionalProperties": false
  }
}
