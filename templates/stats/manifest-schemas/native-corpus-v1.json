{
  "schema_id": "harness-stats-native-corpus",
  "schema_version": "v1",
  "spec_anchor": "stats-3 票载裁决⑧（native-corpus-manifest 新 schema——独立于 pilot-bundle 四源语义；字段=corpus root/逐文件 path+hash+size+mtime/eligible 谓词（时间窗+workDir→project 归属）/观测时刻，沿 bundle 纪律）+ 22 §5.3（type allowlist/字段纪律）",
  "description": "Kimi/Codex 原生源冻结 corpus manifest（一次性冻结接触的产物）。pilot 语义冻结：窗口=UTC 半开 [2026-09-01T00:00Z, 2026-10-01T00:00Z)、project=AITrader2（与 pilot-bundle 同窗——§5.8）。裁决⑤：原生面仅产 model-request（parent_entity_id=null），不产 dispatch；project 归因由 eligible 谓词在冻结时执行（workDir→注册表）。裁决⑦：游标 id=relpath#line、全序=文件相对路径字典序→行号。fixture 外形：{fixture_kind:'native-corpus', …字段}。",
  "fixture_envelope": {
    "rule": "VR-S28",
    "type": "object",
    "required": [
      "fixture_kind"
    ],
    "properties": {
      "fixture_kind": {
        "type": "string",
        "const": "native-corpus"
      },
      "description": {
        "type": "string"
      }
    }
  },
  "manifest": {
    "rule": "VR-S32",
    "type": "object",
    "required": [
      "manifest_kind",
      "corpus_id",
      "created_at",
      "observed_at",
      "project_id",
      "time_range",
      "kimi",
      "codex"
    ],
    "properties": {
      "manifest_kind": {
        "type": "string",
        "const": "native-corpus"
      },
      "corpus_id": {
        "type": "string",
        "pattern": "^native-[a-z0-9][a-z0-9-]*-\\d{6}-[0-9a-f]{8}$",
        "description": "内容寻址：native-<project>-<yyyymm>-<sha8>"
      },
      "created_at": {
        "type": "string",
        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$",
        "rule": "VR-S14"
      },
      "observed_at": {
        "type": "string",
        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$",
        "rule": "VR-S14",
        "description": "观测时刻（裁决⑧字段；活库数字必附 observed_at——22 §2.4 数字纪律）"
      },
      "project_id": {
        "type": "string",
        "minLength": 1
      },
      "time_range": {
        "type": "object",
        "required": [
          "from",
          "until",
          "bounds"
        ],
        "properties": {
          "from": {
            "type": "string",
            "const": "2026-09-01T00:00:00Z"
          },
          "until": {
            "type": "string",
            "const": "2026-10-01T00:00:00Z"
          },
          "bounds": {
            "type": "string",
            "const": "半开 [2026-09-01T00:00:00Z, 2026-10-01T00:00:00Z)"
          }
        },
        "additionalProperties": false
      },
      "kimi": {
        "type": "object",
        "rule": "VR-S32",
        "required": [
          "adapter_id",
          "adapter_type",
          "source_root",
          "total_scanned",
          "eligible_count",
          "excluded",
          "workdir_field",
          "time_field",
          "time_interval",
          "eligible_predicate",
          "eligible_files"
        ],
        "properties": {
          "adapter_id": {
            "type": "string",
            "const": "kimi-wire"
          },
          "adapter_type": {
            "type": "string",
            "const": "append-only",
            "description": "22 §5.3 两型；append-only 行不可变（§5.2 行 209）"
          },
          "source_root": {
            "type": "string",
            "minLength": 1,
            "description": "源根（冻结时观测；~/.kimi-code）"
          },
          "total_scanned": {
            "type": "integer",
            "minimum": 0
          },
          "eligible_count": {
            "type": "integer",
            "minimum": 0
          },
          "excluded": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "reason",
                "count"
              ],
              "properties": {
                "reason": {
                  "type": "string",
                  "minLength": 1
                },
                "count": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            }
          },
          "workdir_field": {
            "type": "string",
            "const": "session_index.jsonl workDir（会话目录级 join）"
          },
          "time_field": {
            "type": "string",
            "minLength": 1,
            "description": "实际执行的时间判定字段声明（首条 allowlist 行时戳；不可得时=mtime-approx 并注记）"
          },
          "time_interval": {
            "type": "string",
            "const": "[2026-09-01T00:00Z, 2026-10-01T00:00Z)"
          },
          "eligible_predicate": {
            "type": "string",
            "const": "project 判定（session_index.jsonl workDir 归属 AITrader2，规范化 project_id 匹配）AND 会话时间判定（首条 allowlist 行时戳 ∈ [2026-09-01T00:00Z, 2026-10-01T00:00Z)；行时戳不可得时以文件 mtime 近似并在 time_field 注记 mtime-approx）"
          },
          "eligible_files": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "relative_path",
                "sha256",
                "size_bytes",
                "mtime_ms",
                "workdir",
                "session_first_at",
                "session_last_at"
              ],
              "properties": {
                "relative_path": {
                  "type": "string",
                  "minLength": 1,
                  "description": "源根内相对路径（wire.jsonl 所在会话目录相对位）"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$",
                  "rule": "VR-S27"
                },
                "size_bytes": {
                  "type": "integer",
                  "minimum": 0
                },
                "mtime_ms": {
                  "type": "integer",
                  "minimum": 0
                },
                "workdir": {
                  "type": "string",
                  "minLength": 1,
                  "description": "session_index workDir 原值（归因判定输入）"
                },
                "session_first_at": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$",
                  "rule": "VR-S14",
                  "description": "首条 allowlist 行时戳（mtime 近似时=time_field 注记 mtime-approx；不可得=null）"
                },
                "session_last_at": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$",
                  "rule": "VR-S14"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      },
      "codex": {
        "type": "object",
        "rule": "VR-S32",
        "required": [
          "adapter_id",
          "adapter_type",
          "source_root",
          "total_scanned",
          "eligible_count",
          "excluded",
          "workdir_field",
          "time_field",
          "time_interval",
          "eligible_predicate",
          "eligible_files"
        ],
        "properties": {
          "adapter_id": {
            "type": "string",
            "const": "codex-sessions"
          },
          "adapter_type": {
            "type": "string",
            "const": "append-only"
          },
          "source_root": {
            "type": "string",
            "minLength": 1,
            "description": "源根（冻结时观测；~/.codex/sessions）"
          },
          "total_scanned": {
            "type": "integer",
            "minimum": 0
          },
          "eligible_count": {
            "type": "integer",
            "minimum": 0
          },
          "excluded": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "reason",
                "count"
              ],
              "properties": {
                "reason": {
                  "type": "string",
                  "minLength": 1
                },
                "count": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            }
          },
          "workdir_field": {
            "type": "string",
            "const": "rollout session_meta.payload.cwd"
          },
          "time_field": {
            "type": "string",
            "minLength": 1,
            "description": "实际执行的时间判定字段声明（session_meta 时戳；不可得时=mtime-approx 并注记）"
          },
          "time_interval": {
            "type": "string",
            "const": "[2026-09-01T00:00Z, 2026-10-01T00:00Z)"
          },
          "eligible_predicate": {
            "type": "string",
            "const": "project 判定（rollout session_meta.payload.cwd 归属 AITrader2，规范化 project_id 匹配）AND 会话时间判定（session_meta 首行时戳 ∈ [2026-09-01T00:00Z, 2026-10-01T00:00Z)；时戳不可得时以文件 mtime 近似并在 time_field 注记 mtime-approx）"
          },
          "eligible_files": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "relative_path",
                "sha256",
                "size_bytes",
                "mtime_ms",
                "workdir",
                "session_first_at",
                "session_last_at"
              ],
              "properties": {
                "relative_path": {
                  "type": "string",
                  "minLength": 1,
                  "description": "sessions/ 内相对路径（YYYY/MM/DD/rollout-*.jsonl）"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$",
                  "rule": "VR-S27"
                },
                "size_bytes": {
                  "type": "integer",
                  "minimum": 0
                },
                "mtime_ms": {
                  "type": "integer",
                  "minimum": 0
                },
                "workdir": {
                  "type": "string",
                  "minLength": 1
                },
                "session_first_at": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$",
                  "rule": "VR-S14"
                },
                "session_last_at": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$",
                  "rule": "VR-S14"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "additionalProperties": false
  }
}
