{
  "_readme": "用户级 hooks 配置模板（~/.zcode/cli/config.json 的 hooks 段；全项目通用一次部署）。实际部署时：①三处 __HARNESS__ 替换为 harness 仓库绝对路径（正斜杠，即 .zcode/hooks/ 执行位所在——该执行位由人工自本仓库 templates/hooks/ 复制创建，sync-harness.mjs 对此只报告不代写，防 AI 换掉运行中的 guard）；②hindsight 四条用绝对路径（由 hindsight-zcode 安装器注册，本模板省略）；guard 靠白名单防跨项目泄漏（非团队项目静默放行）。与 hindsight 插件的 config 合并时保持事件分组结构。",
  "hooks": {
    "enabled": true,
    "events": {
      "PreToolUse": [
        {
          "matcher": "Write|Edit|ApplyPatch",
          "hooks": [
            {
              "type": "command",
              "command": "node \"__HARNESS__/.zcode/hooks/guard-worktree.mjs\"",
              "timeout": 5,
              "statusMessage": "写入隔离检查"
            }
          ]
        }
      ],
      "UserPromptSubmit": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "node \"__HARNESS__/.zcode/hooks/inject-memory.mjs\"",
              "timeout": 10,
              "statusMessage": "团队记忆注入"
            }
          ]
        },
        {
          "hooks": [
            {
              "type": "command",
              "command": "node \"__HARNESS__/.zcode/hooks/report-worktrees.mjs\"",
              "timeout": 10,
              "statusMessage": "分支状态检查（待合并/待归档）"
            }
          ]
        }
      ]
    }
  }
}
