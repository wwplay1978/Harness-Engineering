{
  "_readme": "用户级 hooks 配置模板（~/.zcode/cli/config.json 的 hooks 段；全项目通用一次部署，2026-09-02 已按此部署）。实际部署时：hindsight 四条用绝对路径（Python 与脚本路径见 ~/.zcode/hooks/hindsight/）；三正式脚本路径指向 Zcode_T1 仓库 .zcode/hooks/（执行位，人工自 templates/hooks/ 同步——sync-harness.mjs 对此只报告不代写，防 AI 换掉运行中的 guard）；guard 靠白名单防跨项目泄漏（非团队项目静默放行）。与 hindsight 插件的 config 合并时保持事件分组结构。本模板省略 hindsight 四条（由 hindsight-zcode 安装器注册），只展示三正式脚本的注册形态。",
  "hooks": {
    "enabled": true,
    "events": {
      "PreToolUse": [
        {
          "matcher": "Write|Edit|ApplyPatch",
          "hooks": [
            {
              "type": "command",
              "command": "node \"C:/Forex/Project/Zcode_T1/.zcode/hooks/guard-worktree.mjs\"",
              "timeout": 5,
              "statusMessage": "写入隔离检查"
            }
          ]
        }
      ],
      "UserPromptSubmit": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "node \"C:/Forex/Project/Zcode_T1/.zcode/hooks/inject-memory.mjs\"",
              "timeout": 10,
              "statusMessage": "团队记忆注入"
            }
          ]
        },
        {
          "hooks": [
            {
              "type": "command",
              "command": "node \"C:/Forex/Project/Zcode_T1/.zcode/hooks/report-worktrees.mjs\"",
              "timeout": 10,
              "statusMessage": "分支状态检查（待合并/待归档）"
            }
          ]
        }
      ]
    }
  }
}
