{
  "_readme": "claude-code 三正式 hooks 粘贴块（N18 适配包，docs/18 §2）。部署两步（均人闸，docs/05 §3）：①人工把 templates/hooks/ 三个 .mjs 复制到 ~/.claude/hooks/harness/（宿主用户域执行位）；②三处 __HOME__ 替换为展开后的用户主目录绝对路径（正斜杠，如 C:/Users/you；禁用 ~ 字面量——settings.json 命令串不展开 tilde），把 hooks 键并入 ~/.claude/settings.json（已有 hooks 按事件合并）。__HARNESS__ 仅探针步骤使用（见本目录 README 第 3 步）。",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|ApplyPatch",
        "hooks": [
          {
            "type": "command",
            "command": "node \"__HOME__/.claude/hooks/harness/guard-worktree.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"__HOME__/.claude/hooks/harness/inject-memory.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"__HOME__/.claude/hooks/harness/report-worktrees.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
